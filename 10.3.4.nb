Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["En", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["v", "2"], " ", 
       RowBox[{"cos", "(", "\[Theta]", ")"}]}], "-", 
      SuperscriptBox["v", "2"], "+", "2"}], ")"}]}], 
