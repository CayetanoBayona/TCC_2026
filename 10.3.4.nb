Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Definimos", " ", "un", " ", "cuadrivector", " ", "temporal", " ", 
     "unitario", " ", "n"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], ")"}], " ", "As\[IAcute]", 
     " ", 
     RowBox[{"\[Gamma]", "^", "0"}], " ", "se", " ", "escribe", " ", "como", " ", 
     RowBox[{"GS", "[", "n", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"n", " ", "slash"}], ")"}], " ", "y", " ", "su", " ", 
     "producto", " ", "escalar", " ", "con", " ", "un", " ", "momento", " ", 
     "extrae", " ", "la", " ", "energ\[IAcute]a"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"n", ",", "n"}], "]"}], "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"n", ",", "pi"}], "]"}], "=", "En"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"n", ",", "pf"}], "]"}], "=", "En"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Cinem\[AAcute]tica", " ", "de", " ", "la", " ", "dispersi\[OAcute]n", " ",
      "el\[AAcute]stica"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"pi", ",", "pi"}], "]"}], "=", 
     RowBox[{"m", "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"pf", ",", "pf"}], "]"}], "=", 
     RowBox[{"m", "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SP", "[", 
      RowBox[{"pi", ",", "pf"}], "]"}], "=", 
     RowBox[{
      RowBox[{"En", "^", "2"}], "-", 
      RowBox[{
       RowBox[{"p", "^", "2"}], " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "C\[AAcute]lculo", " ", "del", " ", "promedio", " ", "con", " ", "la", " ",
      "traza"}], "*)"}], 
   RowBox[{
    RowBox[{"traza", "=", 
     RowBox[{
      RowBox[{"TR", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GS", "[", "pf", "]"}], "+", "m"}], ")"}], ".", 
        RowBox[{"GS", "[", "n", "]"}], ".", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GS", "[", "pi", "]"}], "+", "m"}], ")"}], ".", 
        RowBox[{"GS", "[", "n", "]"}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"8", " ", 
        RowBox[{"m", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trazaEval", "=", 
     RowBox[{
      RowBox[{"traza", "//", "DiracSimplify"}], "//", "Simplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Uso", " ", "de", " ", "reglas", " ", "de", " ", 
     "simplificaci\[OAcute]n"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reglasFinales", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "^", "2"}], "->", 
        RowBox[{
         RowBox[{"En", "^", "2"}], "-", 
         RowBox[{"p", "^", "2"}]}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", "2"}]}]}]}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"paso1", "=", 
     RowBox[{
      RowBox[{"trazaEval", "/.", " ", "reglasFinales"}], "//", "Simplify"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Momento", " ", "por", " ", "velocidad", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "^", "2"}], "=", 
       RowBox[{
        RowBox[{"En", "^", "2"}], "*", 
        RowBox[{"v", "^", "2"}]}]}], ")"}]}], "*)"}], "\n", 
   RowBox[{"trazaFinal", "=", 
    RowBox[{
     RowBox[{"paso1", "/.", " ", 
      RowBox[{
       RowBox[{"p", "^", "2"}], "->", 
       RowBox[{
        RowBox[{"En", "^", "2"}], " ", 
        RowBox[{"v", "^", "2"}]}]}]}], "//", "FullSimplify"}]}]}]}]], "Input",
 CellChangeTimes->{{3.992975772518738*^9, 3.992975782756403*^9}, 
   3.9929760241910267`*^9, {3.992976416433235*^9, 3.9929764170961914`*^9}, {
